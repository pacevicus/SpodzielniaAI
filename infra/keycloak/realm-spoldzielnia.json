      "enabled": true,
      "realmRoles": ["MEMBER", "EXPERT"],
      "credentials": [{ "type": "password", "value": "${DEV_USER_PASSWORD}", "temporary": false }]
    },
    {
      "username": "admin1",
      "email": "admin1@spoldzielnia.localhost",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "One",
      "enabled": true,
      "realmRoles": ["MEMBER", "ADMIN"],
      "credentials": [
        { "type": "password", "value": "${DEV_USER_PASSWORD}", "temporary": false },
        {
          "type": "otp",
          "userLabel": "dev-totp",
          "secretData": "{\"value\":\"${DEV_TOTP_SEED}\"}",
          "credentialData": "{\"subType\":\"totp\",\"digits\":6,\"counter\":0,\"period\":30,\"algorithm\":\"HmacSHA1\"}"
        }
      ]
    },
    {
      "username": "member",
      "email": "member@spoldzielnia.localhost",
      "emailVerified": true,
